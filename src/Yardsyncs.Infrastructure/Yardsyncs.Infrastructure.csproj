<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="ClosedXML" Version="0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yardsyncs.Application\Yardsyncs.Application.csproj" />
  </ItemGroup>

  <!-- The database schema and its migrations travel inside the assembly, so "migrate" works from the published app. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\schema.sql" LogicalName="db/schema.sql" />
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="db/migrations/%(Filename)%(Extension)" />
    <!-- The user guides and technical pages (also shown by the portal), for the AI assistant. -->
    <EmbeddedResource Include="..\..\web\src\help\en\*.md" LogicalName="help/en/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\web\src\help\ar\*.md" LogicalName="help/ar/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\web\src\help\tech\*.md" LogicalName="help/tech/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yardsyncs.Infrastructure.Tests" />
  </ItemGroup>

</Project>
