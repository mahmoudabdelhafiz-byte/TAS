{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tas": "Host=localhost;Port=5432;Database=tas;Username=tas;Password=change-me"
  },
  "SlotGeneration": {
    "Enabled": true,
    "IntervalHours": 6
  },
  "Jwt": {
    "Issuer": "tas",
    "Audience": "tas",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "RateLimit": {
    "AuthPerMinute": 10
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Notifications": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "MaxAgeHours": 12,
    "ReminderHoursBefore": 2,
    "PortalUrl": "https://tas.terminal.example",
    "Sms": {
      "Provider": "None",
      "Http": {
        "Url": "https://sms-gateway.example/api/send",
        "Method": "POST",
        "BodyFormat": "json",
        "Body": "{\"recipients\":[\"{to}\"],\"body\":\"{text}\",\"sender\":\"{sender}\"}",
        "Headers": { "Authorization": "Bearer change-me" },
        "Sender": "TERMINAL",
        "NumberFormat": "NoPlus",
        "MessageIdPath": "messageId",
        "TimeoutSeconds": 15
      }
    },
    "Email": {
      "Provider": "None",
      "Host": "smtp.example.com",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "From": "no-reply@terminal.example",
      "FromName": "Yardsyncs"
    }
  },
  "PasswordTokens": {
    "ResetMinutes": 60,
    "InviteDays": 7,
    "MaxResetRequestsPerHour": 3
  },
  "Portal": {
    "Path": "../../portal/dist"
  },
  "Tos": {
    "Adapter": "Fake",
    "OnUnavailable": "Warn"
  },
  "N4": {
    "Terminals": {
      "JED1": {
        "Url": "http://n4-server:9080/apex/services/argoservice",
        "Username": "tas-ws",
        "Password": "",
        "OperatorId": "",
        "ComplexId": "",
        "FacilityId": "",
        "YardId": "",
        "CodeExtension": "TasLookup",
        "TimeoutSeconds": 15
      }
    },
    "HoldMapping": {}
  }
}
