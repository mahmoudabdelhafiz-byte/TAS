# Yardsyncs settings for deploy/docker-compose.yml. Copy to .env and fill in. Keep .env out of version control:
# it holds the secrets. Any setting of src/Tas.Api/appsettings.json can be given here as Section__Key=value.

# ---- server and HTTPS
TAS_DOMAIN=tas.example.com
# Your email for a public Let's Encrypt certificate, or "internal" for a terminal network without internet.
TLS=it@example.com
TZ=Asia/Riyadh

# ---- database (only the app and the backup service use it; it is not published on the network)
DB_PASSWORD=

# ---- security
# Sign-in tokens, at least 32 bytes:            openssl rand -base64 48
Jwt__SigningKey=
# Gate pass secrets at rest, exactly 32 bytes:  openssl rand -base64 32
GatePass__Key=

# The first system administrator, created on the first start (change the password after signing in).
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword=

# ---- terminal operating system: Fake (demo) or N4
Tos__Adapter=Fake
# N4__Terminals__JED1__Url=http://n4-server:9080/apex/services/argoservice
# N4__Terminals__JED1__Username=tas-ws
# N4__Terminals__JED1__Password=

# ---- messages
Notifications__SmsProvider=Log
Notifications__EmailProvider=Log
# Notifications__Unifonic__AppSid=
# Notifications__Smtp__Host=smtp.example.com
# Notifications__Smtp__Username=
# Notifications__Smtp__Password=
# Notifications__Smtp__From=yardsyncs@example.com
# Push to Yardsyncs mobile (Firebase service account):
# Notifications__PushProvider=Fcm
# Notifications__Fcm__ProjectId=
# Notifications__Fcm__ClientEmail=
# Notifications__Fcm__PrivateKey=

# ---- events to the terminal's own systems (optional, per terminal code)
# Integration__Terminals__JED1__Url=https://tos-gateway.example.com/yardsyncs-events
# Integration__Terminals__JED1__Secret=

# ---- backups
BACKUP_AT=01:30
BACKUP_DAYS=14

# ---- image (leave as is to build from this folder; or a registry image, e.g. ghcr.io/…/yardsyncs:1.0.0)
YARDSYNCS_IMAGE=yardsyncs:latest
