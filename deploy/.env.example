# Yardsyncs settings for deploy/docker-compose.yml. Copy to .env and fill in. Keep .env out of version control:
# it holds the secrets. Any setting of src/Yardsyncs.Api/appsettings.json can be given here as Section__Key=value.

# ---- server and HTTPS
TAS_DOMAIN=tas.example.com
# Your email for a public Let's Encrypt certificate, or "internal" for a terminal network without internet.
TLS=it@example.com
TZ=Asia/Riyadh

# ---- database (only the app and the backup service use it; it is not published on the network)
DB_PASSWORD=
# Connections: the app's pool (DB_POOL, default 60) must stay below PostgreSQL's limit (DB_MAX_CONNECTIONS, default 150)
# DB_POOL=60
# DB_MAX_CONNECTIONS=150

# ---- security
# Sign-in tokens, at least 32 bytes:            openssl rand -base64 48
Jwt__SigningKey=
# Gate pass secrets at rest, exactly 32 bytes:  openssl rand -base64 32
GatePass__Key=

# The first system administrator, created on the first start (change the password after signing in).
Bootstrap__AdminEmail=admin@example.com
Bootstrap__AdminPassword=

# ---- terminal operating system: Fake (demo) or N4
Tos__Adapter=Fake
# N4__Terminals__JED1__Url=http://n4-server:9080/apex/services/argoservice
# N4__Terminals__JED1__Username=tas-ws
# N4__Terminals__JED1__Password=

# ---- messages
Notifications__SmsProvider=Log
Notifications__EmailProvider=Log
# Notifications__Unifonic__AppSid=
# Notifications__Smtp__Host=smtp.example.com
# Notifications__Smtp__Username=
# Notifications__Smtp__Password=
# Notifications__Smtp__From=yardsyncs@example.com
# Push to Yardsyncs mobile (Firebase service account):
# Notifications__PushProvider=Fcm
# Notifications__Fcm__ProjectId=
# Notifications__Fcm__ClientEmail=
# Notifications__Fcm__PrivateKey=

# ---- operators' own web addresses (branding), separated by spaces; each must point at this server
# TAS_EXTRA_DOMAINS=tas.harbor-one.example

# ---- modules: what this installation runs. false = the truck appointment system alone (the terminal keeps its own
# gate system and connects it with a key from Lanes → Gate systems). A terminal without Autogate on an installation
# with it: a system admin sets that terminal's setting module_autogate to 0.
# Modules__Autogate=true

# ---- admins sign in with a password and a code from an authenticator app (Required). Optional only for demos.
# Auth__AdminTwoStep=Required

# ---- country: how mobile numbers and plates are read, the drivers' ID document, public holidays, currency
# SA (default), AE, OM, BH, KW or QA. A terminal in another country: Terminals__<code>__Country (holidays, currency)
# Country=SA

# ---- several terminals on this installation: settings per terminal code (anything not set comes from above)
# Terminals__JED1__Tos=N4
# Terminals__JED1__Brand=Harbor One Terminal
# Terminals__JED1__Country=SA
# Terminals__JED1__Notifications__Unifonic__SenderId=HARBOR1
# Terminals__JED1__Notifications__Smtp__From=tas@harbor-one.example
# Brand=Yardsyncs

# ---- events to the terminal's own systems (optional, per terminal code)
# Integration__Terminals__JED1__Url=https://tos-gateway.example.com/yardsyncs-events
# Integration__Terminals__JED1__Secret=

# ---- personal data (Saudi PDPL): how long details are kept, in days
Privacy__LocationDays=30
Privacy__MessageDays=180
Privacy__EventDays=90

# ---- AI assistant in the portal (off without a key). Questions and, with live data, the user's appointments and
# containers are sent to Anthropic: name it in the privacy notice, or set LiveData=false (guides only).
# Assistant__ApiKey=
# Assistant__LiveData=true
# Assistant__DailyQuestionsPerUser=60

# ---- backups
BACKUP_AT=01:30
BACKUP_DAYS=14

# ---- image: a released version (./upgrade.sh 1.2.0 sets this), or yardsyncs:latest to build from this folder
YARDSYNCS_IMAGE=yardsyncs:latest
