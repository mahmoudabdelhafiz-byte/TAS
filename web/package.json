{
  "name": "yardsyncs-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:demo": "node demo/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "preview": "vite preview",
    "language-template": "node --experimental-strip-types --no-warnings scripts/language-template.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
